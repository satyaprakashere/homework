(define + add)
(define - sub)
(define * mul)
(define / div)
(define = numeq)
(define < less_than)
(define > greater_than)
(define car first)
(define cdr rest)
(defmacro begin body (cons (quote do) body))
(define number->string number-to-string)
(define #t true)
(define #f false)

(define (caar x) (car (car x)))
(define (cadr x) (car (cdr x)))
(define (cdar x) (cdr (car x)))
(define (cddr x) (cdr (cdr x)))
