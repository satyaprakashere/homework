Int and Integer, Natural, NegInteger, Rational, Complex
Float and Float64(1..1024)

func fact n = n * recur (n-1)
func fact n = n * recur 1 (n-1)

func fact n = recur 1 { acc, n in
  acc * n
}

func fact n = recur acc(1) { n in
  acc = acc * n
  n = n-1
}

func zip x y f = recur i(0) j(0) z {
  z := make (x.type, size: min(x.size, y.size))
  
  if i >= x.size || i >= y.size return z
  
  z[i] = f (x[i], y[i])
}