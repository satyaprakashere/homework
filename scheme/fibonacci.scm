(define (println x)
    (display x)
    (newline))

(println "hello world")
(define imax 5223372036854775807)
(define x (arithmetic-shift 1 63))
(println imax)
(println (integer? x))
(println (integer? imax))
(define y (+ imax imax))
(println y)
(println (integer? y))

(define (fibonacci n)
    (define (fibs a b n)
        (if (< n 1) a (fibs b (modulo (+ a b) imax) (- n 1))))
    (fibs 0 1 n))
(println (fibonacci 9876))
