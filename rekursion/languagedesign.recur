define factorial n as
    recur factorial (n-1 <- n, res*n <- res) [res=1] when n is greater than 1;
    res otherwise
define fibonacci n as recur fibonacci (b <- a, b+a <- b, n-1 <- n) [a=0,b=1) when n is greater than 2; b otherwise

factorialFunc_nArg factorialRecurCall_

function factorial(n: Integer, res = 1) {
    case (n is 1) -> res;
    otherwise     -> factorial(n-1, res*n);
}

function fibonacci(n, a=0, b=1) {
    case (n is 2) -> b;
    otherwise     -> fibonacci(n-1, b, a+b);
}

function fibonacci(n) = unfold(0, 1, addLastTwo).take(n)

with ac = 1
function fibonacci(n) {
    if n is 1 { ac }
} recur (n-1) {
    ac * n
}

function fibonacci(n) = recur (n-1) {
    * n
}

