<!-- ======================================================================= -->
<!-- Example 10: Server-Side Dynamic HTML & CSS via Rekursion VM            -->
<!-- File: 10_server_rendered_page.rhtml                                     -->
<!-- Execution: ./out/rekursion 10_server_rendered_page.rhtml                -->
<!-- Model: Evaluated on Rekursion VM with embedded server-side blocks       -->
<!-- ======================================================================= -->

<server>
(define (fib_helper n a b)
  (if (less_than n 1)
      a
      (recur (sub n 1) b (add a b))))

(define (fib n)
  (fib_helper n 0 1))

(define (format_currency amount)
  (string_append "$" (number_to_string amount)))

(define server_name "Rekursion VM Edge Node")
(define cpu_cores 8)
(define memory_mb 4096)
(define current_revenue 28540)
</server>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><server>server_name</server></title>
  <style>
    :root {
      --bg-canvas: #0f172a;
      --bg-card: #1e293b;
      --border-card: #334155;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --success: #4ade80;
    }

    body {
      margin: 0;
      padding: 40px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-canvas);
      color: var(--text-main);
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    header {
      margin-bottom: 32px;
      border-bottom: 1px solid var(--border-card);
      padding-bottom: 16px;
    }

    h1 {
      margin: 0 0 8px 0;
      color: var(--accent);
      font-size: 28px;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 14px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      padding: 20px;
    }

    .card-title {
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .card-value {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-main);
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
      background: rgba(74, 222, 128, 0.15);
      color: var(--success);
      margin-top: 12px;
    }

    .table-section {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      padding: 24px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
    }

    th, td {
      text-align: left;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-card);
    }

    th {
      color: var(--text-muted);
      font-size: 13px;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1><server>server_name</server></h1>
      <div class="subtitle">Real-time status generated natively by the Rekursion Bytecode VM</div>
    </header>

    <div class="grid">
      <div class="card">
        <div class="card-title">Compute Cluster</div>
        <div class="card-value"><server>cpu_cores</server> Cores</div>
        <div class="badge">Online</div>
      </div>
      <div class="card">
        <div class="card-title">Allocated RAM</div>
        <div class="card-value"><server>memory_mb</server> MB</div>
        <div class="badge">Hardware Arena</div>
      </div>
      <div class="card">
        <div class="card-title">Monthly Revenue</div>
        <div class="card-value"><server>(format_currency current_revenue)</server></div>
        <div class="badge">+18.4% MoM</div>
      </div>
    </div>

    <div class="table-section">
      <h2>Server-Side Computed Sequence (Fibonacci)</h2>
      <p style="color: var(--text-muted);">Computed via bounded tail recursion in the Rekursion VM environment:</p>
      <table>
        <thead>
          <tr>
            <th>Index (n)</th>
            <th>Gödel Recursive Calculation</th>
            <th>Result Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>n = 5</td>
            <td>(fib 5)</td>
            <td><strong><server>(fib 5)</server></strong></td>
          </tr>
          <tr>
            <td>n = 10</td>
            <td>(fib 10)</td>
            <td><strong><server>(fib 10)</server></strong></td>
          </tr>
          <tr>
            <td>n = 15</td>
            <td>(fib 15)</td>
            <td><strong><server>(fib 15)</server></strong></td>
          </tr>
          <tr>
            <td>n = 20</td>
            <td>(fib 20)</td>
            <td><strong><server>(fib 20)</server></strong></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
