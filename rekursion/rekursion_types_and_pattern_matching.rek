;; =============================================================================
;; Example 3: User-Defined Types & Pattern Matching
;; File: 03_rekursion_types_and_pattern_matching.rek
;; Rules:
;;   - User-defined types in PascalCase (e.g. Point, Color, Shape)
;;   - Product types with 'record' (data-oriented flat array backed)
;;   - Tagged sum/union types with 'variant'
;;   - Fallback pattern matching with 'unless'
;;   - Exhaustive pattern matching with 'match'
;; =============================================================================

;; 1. Product Type: 2D Point (flat hardware array backing)
(record Point [x int] [y int])

;; 2. Sum / Variant Type: Geometric Shapes
(variant Shape
  [Circle int]
  [Rectangle int int])

;; 3. Area calculation using pattern matching
(function (shape_area s)
  (match s
    ((Circle r) (mul (mul 3 r) r)) ;; approximation pi ~ 3
    ((Rectangle w h) (mul w h))))

;; 4. Fallback pattern matching using 'unless'
;; Syntax: (<default> unless <target> ((<case-pattern> <action>)))
(function (safe_circle_radius s)
  (0 unless s
    ((Circle r) :when (greater_than r 0) r)))

;; 5. Create instances
(let pt (Point 15 25))
(let c1 (Circle 7))
(let r1 (Rectangle 8 12))
(let c_neg (Circle -3))

;; 6. Field accessors generated by record
(let px (Point_x pt))
(let py (Point_y pt))

;; 7. Compute areas and evaluate patterns
(let c1_area (shape_area c1))
(let r1_area (shape_area r1))
(let c1_rad (safe_circle_radius c1))
(let c_neg_rad (safe_circle_radius c_neg))

;; 8. Assertions
(assert (equal px 15) "Point_x should be 15")
(assert (equal py 25) "Point_y should be 25")
(assert (equal c1_area 147) "3 * 7 * 7 == 147")
(assert (equal r1_area 96) "8 * 12 == 96")
(assert (equal c1_rad 7) "Radius 7 matches guard")
(assert (equal c_neg_rad 0) "Negative radius falls back to 0")

;; 9. Verification Output
(print "=== 03: User-Defined Types & Pattern Matching ===\n")
(print "Point coordinates: (") (print px) (print ", ") (print py) (print ")\n")
(print "Circle area:       ") (print c1_area) (newline)
(print "Rectangle area:    ") (print r1_area) (newline)
(print "Valid Circle Rad:  ") (print c1_rad) (newline)
(print "Invalid Rad Fallback: ") (print c_neg_rad) (newline)
(print "Types and pattern matching tests passed!\n")
