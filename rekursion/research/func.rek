fib : func (i32) i32 {
case a(0) b(0) n:
	recur(b, a+b, n-1) unless n is 0 then return a
}

fib : func (i32) i32
fib = func a(0) b(0) n {
	recur(b, a+b, n-1) unless n is 0 then return a
}

fib :: func a(0) b(1) n {
	recur(b, a+b, n-1) unless n is 0 then return a
}

fib :: func a b n {
	recur(b, a+b, n-1) unless n is 0 then return a
}

{
	w :: 30 // compile time const
	
	x := 10
	x = 56 // not allowed
	
	// Open/Closed principle
	y := User {
		name: "Satya"
		age:  32
	}
	
	y = nil // not allowed
	
	y.addr = {
		city: "Bangalore"
	}
	
	// const/immutable
	z = User {
		name: "Ved", age: 32
	}
	
	z = nil // not allowed
	
	z.addr = {
		city: "Ludeg"
	} // not allowed
}