(add 1 2) ;; => 3

(add 10 20) ;; => 30

(define + (lambda (a b) (add a b))) ;; => +

(+ 1 2) ;; => 3

(define (fact n)
  (define (loop i acc)
    (if (eq i 0)
        acc
        (recur (sub i 1) (mul i acc))))
  (loop n 1)) ;; => fact

(define factorial fact) ;; => factorial

(factorial 5) ;; => 120
