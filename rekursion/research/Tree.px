module Fibonacci where
  func fibonacci n = recFib n 0 1 where
    func recFib 1 _ b = b
    func recFib n a b = recFib (n-1) b (a+b)
  end
  func fibonacci n = recFib n 0 1 where
    recFib = match
      case 1 _ b => b
      case n a b => recFib (n-1) b (a+b)
  end
end

module BTree where
    alias Int = Int64
    type IntTree = Tree Int
end

module Factorial where
  func factorial n = recFact n 1 where
    func recfact 1 res = res
    func recfact n res = recfact (n-1) (res*n)
  end
  func factorial n = recFact n 1 where
    recfact n res = n match
      1 = res
      n = recfact (n-1) (res*n)
  end
end

