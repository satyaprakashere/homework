protocol Traversal t where
  inorderT : t a -> List[a]
end

@doc "traversal protocols implementaton for Tree"
instance traversableTree = Traversal (Tree a) where
  inorderT = match
    case Empty           => Nil
    case Node (a l r)    => l.inorderT ++ a ++ r.inorderT
  end

  inorderT Empty         = []
  inorderT Node a l r  = l.inorderT ++ a ++ r.inorderT
end

