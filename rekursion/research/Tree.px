data Mat a = Nil | (::) (Vect a) (Mat a)

data Mat a = Nil | (::) (Vect a) (Mat a)

func add : Num a => Mat a -> Mat a -> Mat a
func add m1 m2 = match
  case Nil _ => Nil
  case (v1 :: m1) (v2 :: m2) => v1.(zipWith (+) v2) :: m1.add(m2)

func multVect : Num a => [a] -> Mat a -> Vect a
func multVect (x : []) (v1 :: m1) = v1.(map (*) x)
func multVect (x : xs) (v1 :: m1) = v1.(map (*) x).(zipWith (+) xs.(multVect m1))

func multVect (x : xs) (v1 :: m1) = v1 |> map (*) x |> zipWith (+) (multVect m1 xs)

func mult : Num a => Mat a -> Mat a -> Mat a
func mult Nil _ = Nil
func mult _ Nil = Nil
func mult (v1 :: m1) m2 = v1 * m2 :: m1 * m2




data Mat a = public Nil
          | public (Vect a) (Mat a)
          | private Vect (Vect a)


data Mat a where
  Nil : Mat a
  Mat : Cons (head : Vect a) (tail : Mat a)

data List a = Nil
   | Cons a (List a)

module List a =
    data Nil : List a
      | Cons : (head : a) -> (tail : List a) -> List a

module List a =
    data Nil : List a
    data Cons : (head : a) -> (tail : List a) -> List a where
      Cons.rep : Array a
      Cons.rep = tail.rep.prepend head
      Cons.head <- Cons.rep head
      Cons.tail <- Cons.rep tail

