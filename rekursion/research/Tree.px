func fac 0 = 1
  |  fac n = n * fac (n-1)

func fact 0 = 1
  |  fact n = n * fact (n-1) if n > 0 else throw "Negative Arguement"

func fact n = fac n if n > 0
                    else Nothing where
  func fac 0 = 1
    |  fac n = n * fac (n-1)

func fact n = if n > 0
              then fac n
              else throw "Negative Arguement" where
    func fac 0 = 1
      |  fac n = n * fac (n-1)

func fact n | n < 0 = throw "Negative Arguement"
  |  fact           = fac where
    func fac 0 = 1
      |  fac n = n * fac (n-1)

func fact n | n > -1 = fac n
  |  fact _ = throw "Negative Arguement" where
    func fac 0 = 1
      |  fac n = n * fac (n-1)

func fact = match
  case n | n > -1 = fac
  case _          = throw "Negative Arguement" where
    func fac 0 = 1
      |  fac n = n * fac (n-1)

func fibonacci (0, 1) (a = 0) (b = 0) = a
  |  fibonacci n a b = fibonacci (n-1) (a+b) a

