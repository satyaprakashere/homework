module MatrixMult begin
  protocol MatrixMult m1 m2 m2 | m1 m2 -> m3 begin ; functional dependencies
    (*) : m1 -> m2 -> m3
  end

  protocol MatrixMult m1 m2 m2 where m1, m2, m3 <: Matrix =
      m1 : (m : Nat) -> (n : Nat) -> a -> Type
    | m2 : (n : Nat) -> (p : Nat) -> a -> Type
    | m3 : (m : Nat) -> (p : Nat) -> a -> Type

    | (*) : m1 -> m2 -> m3
  end
end

module MatrixOps begin
  protocol MatripOps mat : Nat -> Nat -> (a <= Num) -> Type | p : Nat begin
  protocol MatripOps mat : Nat -> Nat -> a -> Type | p : Nat where a <: Num

  protocol MatrixOps : (Type -> Type -> Type -> Type) -> {
            (a -> a -> a),
            (a -> a -> a).
            (a -> b -> a),
            (a -> b -> c)
  }

  protocol MatripOps mat <= MatrixMult (mat m n a) a (mat m n a)
                            , MatrixMult (mat m n a) (mat n p a) (mat m p a) where (a <: Num) =
      alias matrix = mat m n a

    (+) : matrix -> matrix -> matrix
    (-) : matrix -> matrix -> matrix
    (*) : matrix -> a -> matrix
    (*) : mat m n a -> mat n p a -> mat m p a

    transpose : mat m n a -> mat n m a
  end

  protocol MatripOps(mat) <= MatrixMult(mat m n a, a, mat m n a)
                            , MatrixMult(mat m n a, mat n p a, mat m p a) where (a <: Num) =
      alias matrix = mat m n a

    (+) : matrix -> matrix -> matrix
    (-) : matrix -> matrix -> matrix
    (*) : matrix -> a -> matrix
    (*) : mat m n a -> mat n p a -> mat m p a

    transpose : mat m n a -> mat n m a
  end
end

module Matrix where
  data Matrix m n a : Nat -> Nat -> Type -> Type where
    Matrix = Vect m (Vect n a)

  data Matrix n m a = Nil | Matrix(Vect m a, Matrix n m a)

  data Matrix n m a = Nil | Matrix<Vect<m, a>, Matrix<n, m, a>>

  data Matrix n m a = Nil | Matrix (Vect m a) (Matrix n m a)

  data Matrix n m a = Nil | (::) (Vect m a) (Matrix n m a)

  data Matrix m n Int = Vect m (Vect n Int)

  type RowVector n a = Matrix 1 n a
  type ColVector m a = Matrix m 1 a
  type SquareMatix n a = Matrix n n a

  val RowVector : Nat -> Nat -> Type -> Type
  val RowVector n a = Matrix 1 n a

  type RowVector n a = Vect n a
  type ColVector m a = Vect m a
  type SquareMatix n a = Matrix n n a


  protocol Matrix mat extends MatrixOps mat where
  protocol Matrix mat <= MatrixOps mat where
  protocol Matrix mat <: MatrixOps mat where
    headRow   : Mat m n a -> RowVector n a
    headCol   : Mat m n a -> ColVector m a
    elementAt : Mat m n a -> Fin -> Fin -> a
  end

  protocol SquareMatrixOps (a Num) => (mat : Nat -> a -> Type MatripOps) where

  protocol SquareMatrixOps mat <= Matrix mat where
    inverse : mat m n a -> Maybe (mat m n a)
    determenent : mat m n a -> a
  end
end

module RowVector where
  type RowVector n a = Matrix 1 n a

