(func (factorial n)
  (if (< n 0)
      (throw "Negative Argument")
      (recFact n 1))
  (func (recFact n res)
    (match (n 1) (res)
          (n n) (recFact (n-1) (res * n)))))

(func (factorial n)
  (match n
         (n (>= 0)) (recFact n a))
         (_)        (throw "Negative Arguement")
  (func (recFact n res)
    (match (n 1) (res)
          (n n) (recFact (n-1) (res * n)))))

(func (factorial n)
  (recFact n 1)
  (where
    (func (recFact n res)
      (match (n 1) (res)
            (n n) (recFact (n-1) (res * n))))))

(func factorial (n)
  (recFact n 1)
  (func recFact (n res)
    (match (n)
      (1 res)
      (n (recFact (n-1) (res * n))))))

