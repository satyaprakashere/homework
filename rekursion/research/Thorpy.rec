fibonacci :: process
	MEMORY_ARENA :: 32 Bytes // Bytes(32)
	
	calculate :: recieve(:msg, n)
		fibonacci 0 1 n
end(process)

-- type signature
fibonacci : (Int, Int, Int) -> Int
fibonacci : (Int ** 3) -> Int

//fibonacci (a Int, b Int, b Int) -> res:Int
fibonacci :: (a, b, c Int) Int

