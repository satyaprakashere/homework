//fibonacci :: function (a, b, n) {
//	fib_tail_base      _ _ 0 	 = a
//	fib_tail_recursive otherwise = fibonacci(a=b, b+=a, n-=1)
//}

fibonacci :: func a b n = recur(a=b, b=b+a, n=n-1) unless
	case n is 0 : a
end(func)

