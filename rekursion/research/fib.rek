//fibonacci function a b n = recur(a=b, b+=a, n-=1) unless {
//	case n is 0 : a
//}

fibonacci : func (Int) Int
fibonacci = func a(0) b(1) n {
	recur(a=b, b+=a, n-=1) unless {
		n is 0 then return a
	}
}

fibonacci :: func (Int) Int
fibonacci =  func a(0) b(1) n {
	recur(a=b, b+=a, n-=1)
	unless n is 0 then return a
}

fibonacci = function a(0) b(1) n {
	recur(a=b, b+=a, n-=1)
	
	unless n is 0 then return a
	unless n is 1 then return b
}



