fibonacci actor {
	MEMORY_ARENA :: 32 Bytes
	
	calculate recieve(:msg, n) {
		fibonacci 0 1 n
	}
}

-- type signature
fibonacci : (Int, Int, Int) -> Int
//fibonacci : (a, b, c Int) Int
fibonacci : (a, b, c Int) -> Int
fibonacci : func (a, b, n Int) Int
