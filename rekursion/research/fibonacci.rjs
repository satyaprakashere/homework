fibonacci: (Int, Int, Int) -> Int
fibonacci: (a, b, n Int) -> Int

//fibonacci a b n = recur(a=b, b+=a, n-=1) unless {
//	case n is 0 : a
//}

fibonacci : (Int) Int
fibonacci = func a(0) b(1) n {
	recur(a=b, b+=a, n-=1) unless {
		n is 0 then return a
	}
}

fibonacci :: func(a=0, b=1, n) {
	recur(a=b, b+=a, n-=1) unless {
		n is 0 then return a
	}
}

